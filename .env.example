# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/impactbridge

# Auth
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email (SendGrid) — leave blank locally, emails print to console instead
SENDGRID_API_KEY=your-sendgrid-key
FROM_EMAIL=noreply@impactbridge.org

# Frontend — used in every email link and for CORS
FRONTEND_URL=https://impact-bridge-saatvika.vercel.app
# Optional: extra comma-separated origins (e.g. a custom domain)
EXTRA_CORS_ORIGINS=

# External scheduler (GitHub Actions cron) — any long random string.
# Must match the AUTOMATION_API_KEY secret in the GitHub repo.
AUTOMATION_API_KEY=

# Optional: plain-English at-risk digest. If blank, digest uses the plain list.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# First-boot demo seed for hosts without shell access (Render free tier).
# Seeds ONLY if the users table is empty; safe to leave on.
AUTO_SEED=false

# Environment
ENVIRONMENT=development
